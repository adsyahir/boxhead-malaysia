{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hantu-kampung-pisang",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // Main address first; the old one stays so Home Screen icons and links made before the rename keep working.
  "routes": [
    { "pattern": "boxhead-hantu-kampung-pisang.adsyahir.com", "custom_domain": true },
    { "pattern": "hantu-kampung-pisang.adsyahir.com", "custom_domain": true }
  ],
  // Keep the *.workers.dev address too, as a backup when the custom domain has trouble.
  "workers_dev": true,
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "hantu-kampung-pisang", "database_id": "1e6f0fd4-bdff-439e-a13f-02423c0750b9" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "LobbyDO"] }]
}
