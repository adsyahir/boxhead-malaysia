{
  "name": "hantu-kampung-pisang",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:web": "pnpm --filter @kampung/web build",
    "deploy": "pnpm --filter @kampung/web build && pnpm --filter @kampung/server deploy",
    "dev:online": "pnpm --filter @kampung/server dev"
  }
}
