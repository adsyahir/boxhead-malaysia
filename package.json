{
  "name": "hantu-kampung-pisang",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:web": "corepack pnpm --filter @kampung/web build",
    "ship": "corepack pnpm --filter @kampung/web build && corepack pnpm --filter @kampung/server run deploy",
    "dev:online": "corepack pnpm --filter @kampung/server dev"
  }
}
